// ===================== КЛИЕНТ =====================

&НаКлиенте
Процедура Загрузить(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл Excel";
	Диалог.МножественныйВыбор = Истина;
	Диалог.Фильтр = "Файлы Excel (*.xlsx;*.xls)|*.xlsx;*.xls";
	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораФайлов", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайлов(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Результат = ЗагрузитьФайлыНаСервере(ВыбранныеФайлы);
	ПоказатьПредупреждение(, Результат);
КонецПроцедуры

// ===================== СЕРВЕР =====================

&НаСервереБезКонтекста
Функция ЗагрузитьФайлыНаСервере(ВыбранныеФайлы)
	Лог = Новый Массив;
	Таблицы = Новый Соответствие;

	// 1. Читаем файлы и определяем, что в каждом из них
	Для Каждого ПутьКФайлу Из ВыбранныеФайлы Цикл
		ФайлДиска = Новый Файл(ПутьКФайлу);
		ИмяФайла = ФайлДиска.Имя;
		Таб = Новый ТабличныйДокумент;
		ТипФайла = "";
		Попытка
			Таб.Прочитать(ПутьКФайлу, СпособЧтенияЗначенийТабличногоДокумента.Значение);
			ТипФайла = ОпределитьТип(Таб);
		Исключение
			Лог.Добавить("Не удалось прочитать файл " + ИмяФайла + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Если ТипФайла = "" Тогда
			Лог.Добавить("Файл не распознан и пропущен: " + ИмяФайла);
			Продолжить;
		КонецЕсли;
		Таблицы.Вставить(ТипФайла, Таб);
		Лог.Добавить("Файл " + ИмяФайла + " распознан как: " + ТипФайла);
	КонецЦикла;

	Лог.Добавить("----------");

	// 2. Загружаем в правильном порядке, с проверкой зависимостей

	ТаблицаДляЗагрузки = Таблицы.Получить("Размеры");
	Если ТаблицаДляЗагрузки <> Неопределено Тогда
		ЗагрузитьРазмеры(ТаблицаДляЗагрузки, Лог);
	КонецЕсли;

	ТаблицаДляЗагрузки = Таблицы.Получить("Пользователи");
	Если ТаблицаДляЗагрузки <> Неопределено Тогда
		ЗагрузитьПользователей(ТаблицаДляЗагрузки, Лог);
	КонецЕсли;

	ТаблицаДляЗагрузки = Таблицы.Получить("Товары");
	Если ТаблицаДляЗагрузки <> Неопределено Тогда
		ЗагрузитьТовары(ТаблицаДляЗагрузки, Лог);
	КонецЕсли;

	ТаблицаДляЗагрузки = Таблицы.Получить("Остатки");
	Если ТаблицаДляЗагрузки <> Неопределено Тогда
		Если Не ЕстьЭлементы("Товары") Или Не ЕстьЭлементы("Размеры") Тогда
			Лог.Добавить("Остатки НЕ загружены: сначала загрузите файлы размеров и товаров, затем повторите");
		Иначе
			ЗагрузитьОстатки(ТаблицаДляЗагрузки, Лог);
		КонецЕсли;
	КонецЕсли;

	ТаблицаДляЗагрузки = Таблицы.Получить("Заказы");
	Если ТаблицаДляЗагрузки <> Неопределено Тогда
		Если Не ЕстьЭлементы("Товары") Или Не ЕстьЭлементы("Размеры") Или Не ЕстьЭлементы("Пользователи") Тогда
			Лог.Добавить("Заказы НЕ загружены: сначала загрузите файлы размеров, пользователей и товаров, затем повторите");
		Иначе
			ЗагрузитьЗаказы(ТаблицаДляЗагрузки, Лог);
		КонецЕсли;
	КонецЕсли;

	Возврат СтрСоединить(Лог, Символы.ПС);
КонецФункции
&НаСервереБезКонтекста
Функция ЕстьЭлементы(ИмяСправочника)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник." + ИмяСправочника);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// ---------- Определение типа файла по заголовкам ----------

&НаСервереБезКонтекста
Функция ОпределитьТип(Таб)
	Заголовок = "";
	Для К = 1 По Таб.ШиринаТаблицы Цикл
		Заголовок = Заголовок + " " + НРег(СокрЛП(Таб.Область(1, К, 1, К).Текст));
	КонецЦикла;

	Если Найти(Заголовок, "номер заказа") > 0 Тогда
		Возврат "Заказы";
	ИначеЕсли Найти(Заголовок, "логин") > 0 Тогда
		Возврат "Пользователи";
	ИначеЕсли Найти(Заголовок, "подкатегор") > 0 Тогда
		Возврат "Товары";
	ИначеЕсли Найти(Заголовок, "доступн") > 0 Тогда
		Возврат "Остатки";
	ИначеЕсли Таб.ШиринаТаблицы = 1 И Найти(Заголовок, "размер") > 0 Тогда
		Возврат "Размеры";
	КонецЕсли;
	Возврат "";
КонецФункции

// ---------- Чтение ячеек и преобразования ----------

&НаСервереБезКонтекста
Функция Яч(Таб, НомерСтроки, НомерКолонки)
	Ячейка = Таб.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	Значение = Неопределено;
	Попытка
		Значение = Ячейка.Значение;
	Исключение
		Значение = Неопределено;
	КонецПопытки;
	Если Значение = Неопределено Тогда
		Значение = Ячейка.Текст;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Значение = СокрЛП(СтрЗаменить(Значение, Символы.НПП, " "));
		Если Значение = "" Тогда
			Значение = СокрЛП(СтрЗаменить(Ячейка.Текст, Символы.НПП, " "));
		КонецЕсли;
	КонецЕсли;
	Возврат Значение;
КонецФункции

&НаСервереБезКонтекста
Функция Тст(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(СтрЗаменить(Строка(Значение), Символы.НПП, " "));
КонецФункции

&НаСервереБезКонтекста
Функция Чис(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = СтрЗаменить(СтрЗаменить(Строка(Значение), " ", ""), Символы.НПП, "");
	Текст = СтрЗаменить(Текст, ",", ".");
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ИмяРазмера(Число)
	Если Число = Цел(Число) Тогда
		Возврат Формат(Число, "ЧДЦ=0; ЧГ=0");
	КонецЕсли;
	Возврат Формат(Число, "ЧДЦ=1; ЧГ=0");
КонецФункции

&НаСервереБезКонтекста
Функция ПривестиДату(Значение)
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = СокрЛП(Строка(Значение));
	ЕстьТочка = Найти(Текст, ".") > 0;
	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, "/", "."), "-", "."), " ", ".");
	Части = СтрРазделить(Текст, ".", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Если СтрДлина(Части[0]) = 4 Тогда
			Год = Число(Части[0]);
			Месяц = Число(Части[1]);
			День = Число(Части[2]);
		ИначеЕсли ЕстьТочка Тогда
			День = Число(Части[0]);
			Месяц = Число(Части[1]);
			Год = Число(Части[2]);
		Иначе
			Месяц = Число(Части[0]);
			День = Число(Части[1]);
			Год = Число(Части[2]);
		КонецЕсли;
		Если Год < 100 Тогда
			Год = Год + 2000;
		КонецЕсли;
		Возврат Дата(Год, Месяц, День);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
КонецФункции

// ---------- Поиск и создание элементов ----------

&НаСервереБезКонтекста
Функция НайтиИлиСоздать(Менеджер, Наименование, Владелец = Неопределено)
	Если Владелец = Неопределено Тогда
		Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
	Иначе
		Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина, , Владелец);
	КонецЕсли;
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;
	Новый_ = Менеджер.СоздатьЭлемент();
	Новый_.Наименование = Наименование;
	Если Владелец <> Неопределено Тогда
		Новый_.Владелец = Владелец;
	КонецЕсли;
	Новый_.Записать();
	Возврат Новый_.Ссылка;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиТовар(Наименование, Производитель)
	// 1. Точное совпадение названия
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Товары
	|ГДЕ Наименование = &Наименование И Производитель.Наименование = &Производитель";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Производитель", Производитель);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// 2. Название в файле короче: ищем товар, название которого начинается с него
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Товары
	|ГДЕ Наименование ПОДОБНО &Шаблон И Производитель.Наименование = &Производитель";
	Запрос.УстановитьПараметр("Шаблон", Наименование + "%");
	Запрос.УстановитьПараметр("Производитель", Производитель);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Товары.ПустаяСсылка();
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьДокументы(ИмяДокумента)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ." + ИмяДокумента);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// ---------- Загрузка по типам ----------

&НаСервереБезКонтекста
Процедура ЗагрузитьРазмеры(Таб, Лог)
	Загружено = 0;
	Для Н = 2 По Таб.ВысотаТаблицы Цикл
		Значение = Яч(Таб, Н, 1);
		Если Тст(Значение) = "" Тогда
			Продолжить;
		КонецЕсли;
		Число_ = Чис(Значение);
		Имя = ИмяРазмера(Число_);
		Ссылка = Справочники.Размеры.НайтиПоНаименованию(Имя, Истина);
		Если Ссылка.Пустая() Тогда
			Элемент_ = Справочники.Размеры.СоздатьЭлемент();
		Иначе
			Элемент_ = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		Элемент_.Наименование = Имя;
		Элемент_.Значение = Число_;
		Элемент_.Записать();
		Загружено = Загружено + 1;
	КонецЦикла;
	Лог.Добавить("Размеры: загружено " + Загружено);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗагрузитьПользователей(Таб, Лог)
	Роли = Новый Соответствие;
	Роли.Вставить("администратор", Перечисления.РолиПользователей.Администратор);
	Роли.Вставить("менеджер", Перечисления.РолиПользователей.Менеджер);
	Роли.Вставить("авторизованный пользователь", Перечисления.РолиПользователей.АвторизованныйПользователь);

	РолиИБ = Новый Соответствие;
	РолиИБ.Вставить("администратор", "Администратор");
	РолиИБ.Вставить("менеджер", "Менеджер");
	РолиИБ.Вставить("авторизованный пользователь", "АвторизованныйПользователь");

	Загружено = 0;
	// Проход 1: администраторы (первый пользователь базы обязан быть администратором), проход 2: остальные
	Для Проход = 1 По 2 Цикл
		Для Н = 2 По Таб.ВысотаТаблицы Цикл
			Логин = Тст(Яч(Таб, Н, 4));
			Если Логин = "" Тогда
				Продолжить;
			КонецЕсли;
			РольТекст = НРег(Тст(Яч(Таб, Н, 5)));
			ЭтоАдмин = (РольТекст = "администратор");
			Если (Проход = 1) <> ЭтоАдмин Тогда
				Продолжить;
			КонецЕсли;

			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Пользователи ГДЕ Логин = &Л");
			Запрос.УстановитьПараметр("Л", Логин);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Элемент_ = Выборка.Ссылка.ПолучитьОбъект();
			Иначе
				Элемент_ = Справочники.Пользователи.СоздатьЭлемент();
			КонецЕсли;
			Элемент_.Фамилия = Тст(Яч(Таб, Н, 1));
			Элемент_.Имя = Тст(Яч(Таб, Н, 2));
			Элемент_.Отчество = Тст(Яч(Таб, Н, 3));
			Элемент_.Логин = Логин;
			Элемент_.Роль = Роли.Получить(РольТекст);
			Элемент_.Записать();

			Попытка
				СоздатьПользователяИБ(Логин, Элемент_.Наименование, РолиИБ.Получить(РольТекст));
			Исключение
				Лог.Добавить("Пользователь для входа " + Логин + " не создан: "
					+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			Загружено = Загружено + 1;
		КонецЦикла;
	КонецЦикла;

	// Гость: пользователь для просмотра каталога без права что-либо менять
	Попытка
		СоздатьПользователяИБ("guest", "Гость", "Гость");
	Исключение
		Лог.Добавить("Пользователь guest не создан: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Лог.Добавить("Пользователи: загружено " + Загружено + " (и гость guest)");
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьПользователяИБ(Логин, ПолноеИмя, ИмяРоли)
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Логин);
	Если ПользовательИБ = Неопределено Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
		ПользовательИБ.Имя = Логин;
	КонецЕсли;
	ПользовательИБ.ПолноеИмя = ПолноеИмя;
	ПользовательИБ.АутентификацияСтандартная = Истина;
	ПользовательИБ.ПоказыватьВСпискеВыбора = Истина;
	ПользовательИБ.ЗапрещеноИзменятьПароль = Истина;
	ПользовательИБ.Пароль = "";
	ПользовательИБ.Роли.Очистить();
	РольИБ = Метаданные.Роли.Найти(ИмяРоли);
	Если РольИБ <> Неопределено Тогда
		ПользовательИБ.Роли.Добавить(РольИБ);
	КонецЕсли;
	ПользовательИБ.Записать();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗагрузитьТовары(Таб, Лог)
	Загружено = 0;
	Для Н = 2 По Таб.ВысотаТаблицы Цикл
		Название = Тст(Яч(Таб, Н, 4));
		Если Название = "" Тогда
			Продолжить;
		КонецЕсли;
		Категория = НайтиИлиСоздать(Справочники.Категории, Тст(Яч(Таб, Н, 1)));
		Подкатегория = НайтиИлиСоздать(Справочники.Подкатегории, Тст(Яч(Таб, Н, 2)), Категория);
		Производитель = НайтиИлиСоздать(Справочники.Производители, Тст(Яч(Таб, Н, 5)));

		Ссылка = НайтиТовар(Название, Тст(Яч(Таб, Н, 5)));
		Если Ссылка.Пустая() Тогда
			Элемент_ = Справочники.Товары.СоздатьЭлемент();
		Иначе
			Элемент_ = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		Элемент_.Наименование = Название;
		Элемент_.Категория = Категория;
		Элемент_.Подкатегория = Подкатегория;
		Элемент_.Производитель = Производитель;
		Элемент_.Описание = Тст(Яч(Таб, Н, 6));
		Элемент_.Состав = Тст(Яч(Таб, Н, 7));
		Элемент_.Цена = Чис(Яч(Таб, Н, 8));
		Элемент_.ИмяФайла = Тст(Яч(Таб, Н, 3)); // само фото добавляется вручную
		Элемент_.Записать();
		Загружено = Загружено + 1;
	КонецЦикла;
	Лог.Добавить("Товары: загружено " + Загружено);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗагрузитьОстатки(Таб, Лог)
	// Файл остатков главный: удаляем прежние поступления (в том числе частично загруженные)
	Удалено = 0;
	ВыборкаДокументов = Документы.ПоступлениеТоваров.Выбрать();
	Пока ВыборкаДокументов.Следующий() Цикл
		ВыборкаДокументов.ПолучитьОбъект().Удалить();
		Удалено = Удалено + 1;
	КонецЦикла;
	Если Удалено > 0 Тогда
		Лог.Добавить("Остатки: удалено прежних поступлений: " + Удалено);
	КонецЕсли;

	Док = Документы.ПоступлениеТоваров.СоздатьДокумент();
	Док.Дата = Дата(2026, 1, 1);
	Пропущено = 0;
	Для Н = 2 По Таб.ВысотаТаблицы Цикл
		Название = Тст(Яч(Таб, Н, 1));
		Если Название = "" Тогда
			Продолжить;
		КонецЕсли;
		Товар = НайтиТовар(Название, Тст(Яч(Таб, Н, 2)));
		Размер = Справочники.Размеры.НайтиПоНаименованию(ИмяРазмера(Чис(Яч(Таб, Н, 3))), Истина);
		Если Товар.Пустая() Или Размер.Пустая() Тогда
			Пропущено = Пропущено + 1;
			Если Пропущено <= 10 Тогда
				Лог.Добавить("Остатки: пропущена строка " + Н + " (" + Название + ", размер "
					+ Тст(Яч(Таб, Н, 3)) + ")");
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Новая = Док.Товары.Добавить();
		Новая.Товар = Товар;
		Новая.Размер = Размер;
		Новая.Количество = Чис(Яч(Таб, Н, 4));
	КонецЦикла;
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Лог.Добавить("Остатки: загружено строк " + Док.Товары.Количество() + ", пропущено " + Пропущено);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗагрузитьЗаказы(Таб, Лог)
	Если ЕстьДокументы("Заказ") Тогда
		Лог.Добавить("Заказы: пропущено, уже были загружены ранее");
		Возврат;
	КонецЕсли;

	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("НомерЗаказа");
	Строки.Колонки.Добавить("ДатаЗаказа");
	Строки.Колонки.Добавить("ФИО");
	Строки.Колонки.Добавить("Товар");
	Строки.Колонки.Добавить("Размер");
	Строки.Колонки.Добавить("Количество");
	Строки.Колонки.Добавить("Цена");

	Для Н = 2 По Таб.ВысотаТаблицы Цикл
		Если Тст(Яч(Таб, Н, 1)) = "" Тогда
			Продолжить;
		КонецЕсли;
		Новая = Строки.Добавить();
		Новая.НомерЗаказа = Чис(Яч(Таб, Н, 1));
		Новая.ДатаЗаказа = ПривестиДату(Яч(Таб, Н, 2));
		Новая.ФИО = Тст(Яч(Таб, Н, 3));
		Новая.Товар = НайтиТовар(Тст(Яч(Таб, Н, 5)), Тст(Яч(Таб, Н, 6)));
		Новая.Размер = Справочники.Размеры.НайтиПоНаименованию(ИмяРазмера(Чис(Яч(Таб, Н, 7))), Истина);
		Новая.Количество = Чис(Яч(Таб, Н, 8));
		Новая.Цена = Чис(Яч(Таб, Н, 9));
	КонецЦикла;

	Шапки = Строки.Скопировать(, "НомерЗаказа, ДатаЗаказа, ФИО");
	Шапки.Свернуть("НомерЗаказа, ДатаЗаказа, ФИО");
	Шапки.Сортировать("НомерЗаказа");

	Загружено = 0;
	Для Каждого Шапка Из Шапки Цикл
		Клиент = Справочники.Пользователи.НайтиПоНаименованию(Шапка.ФИО, Истина);
		Если Клиент.Пустая() Тогда
			Лог.Добавить("Заказы: клиент не найден: " + Шапка.ФИО + " (загрузите файл пользователей)");
			Продолжить;
		КонецЕсли;
		Док = Документы.Заказ.СоздатьДокумент();
		Док.Дата = Шапка.ДатаЗаказа;
		Док.Клиент = Клиент;
		Для Каждого СтрокаЗаказа Из Строки.НайтиСтроки(Новый Структура("НомерЗаказа", Шапка.НомерЗаказа)) Цикл
			Если СтрокаЗаказа.Товар.Пустая() Или СтрокаЗаказа.Размер.Пустая() Тогда
				Лог.Добавить("Заказ " + Шапка.НомерЗаказа + ": товар или размер не найден");
				Продолжить;
			КонецЕсли;
			Новая = Док.Товары.Добавить();
			Новая.Товар = СтрокаЗаказа.Товар;
			Новая.Размер = СтрокаЗаказа.Размер;
			Новая.Количество = СтрокаЗаказа.Количество;
			Новая.Цена = СтрокаЗаказа.Цена;
		КонецЦикла;
		// Только запись без проведения: файл остатков уже содержит актуальные количества
		Док.Записать(РежимЗаписиДокумента.Запись);
		Загружено = Загружено + 1;
	КонецЦикла;
	Лог.Добавить("Заказы: загружено " + Загружено);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДанные(Команда)
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОчистки", ЭтотОбъект),
		"Удалить ВСЕ загруженные данные (товары, пользователей, размеры, остатки, заказы)?",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Очистка данных");
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОчистки(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Результат = ОчиститьДанныеНаСервере();
	ПоказатьПредупреждение(, Результат);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОчиститьДанныеНаСервере()
	Лог = Новый Массив;
	// Порядок важен: сначала документы, потом справочники, которые на них ссылаются
	Лог.Добавить("Заказы: удалено " + УдалитьВсе(Документы.Заказ));
	Лог.Добавить("Поступления товаров: удалено " + УдалитьВсе(Документы.ПоступлениеТоваров));
	Лог.Добавить("Товары: удалено " + УдалитьВсе(Справочники.Товары));
	Лог.Добавить("Подкатегории: удалено " + УдалитьВсе(Справочники.Подкатегории));
	Лог.Добавить("Категории: удалено " + УдалитьВсе(Справочники.Категории));
	Лог.Добавить("Производители: удалено " + УдалитьВсе(Справочники.Производители));
	Лог.Добавить("Размеры: удалено " + УдалитьВсе(Справочники.Размеры));
	Лог.Добавить("Пользователи: удалено " + УдалитьВсе(Справочники.Пользователи));
	Лог.Добавить("----------");
	Лог.Добавить("Готово. Теперь загрузите файлы заново.");
	Возврат СтрСоединить(Лог, Символы.ПС);
КонецФункции

&НаСервереБезКонтекста
Функция УдалитьВсе(Менеджер)
	Количество = 0;
	Выборка = Менеджер.Выбрать();
	Пока Выборка.Следующий() Цикл
		Выборка.ПолучитьОбъект().Удалить();
		Количество = Количество + 1;
	КонецЦикла;
	Возврат Количество;
КонецФункции
