&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Роль = РаботаСПользователем.ТекущаяРоль();
	Авторизован = (Роль <> "Гость");

	// Гость видит только список товаров
	Элементы.Поиск.Видимость = Авторизован;
	Элементы.Категория.Видимость = Авторизован;
	Элементы.Сортировка.Видимость = Авторизован;
	Элементы.Применить.Видимость = Авторизован;
	Элементы.Заказать.Видимость = Авторизован;

	Сортировка = "По названию";
	ОбновитьТовары();
КонецПроцедуры

&НаСервере
Процедура ОбновитьТовары()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Товар,
	|	Т.Наименование КАК Наименование,
	|	Т.Производитель.Наименование КАК Производитель,
	|	Т.Цена КАК Цена,
	|	ЕСТЬNULL(Ост.Количество, 0) КАК Количество
	|ИЗ
	|	Справочник.Товары КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				О.Товар КАК Товар,
	|				СУММА(О.КоличествоОстаток) КАК Количество
	|			ИЗ
	|				РегистрНакопления.ОстаткиТоваров.Остатки КАК О
	|			СГРУППИРОВАТЬ ПО
	|				О.Товар) КАК Ост
	|		ПО Ост.Товар = Т.Ссылка
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И (&Категория = ЗНАЧЕНИЕ(Справочник.Категории.ПустаяСсылка) ИЛИ Т.Категория = &Категория)
	|	И Т.Наименование ПОДОБНО &Поиск
	|";
	Запрос.УстановитьПараметр("Категория", Категория);
	Запрос.УстановитьПараметр("Поиск", "%" + СокрЛП(Поиск) + "%");

	Если Сортировка = "Цена по возрастанию" Тогда
		Запрос.Текст = Запрос.Текст + "УПОРЯДОЧИТЬ ПО Цена, Наименование";
	ИначеЕсли Сортировка = "Цена по убыванию" Тогда
		Запрос.Текст = Запрос.Текст + "УПОРЯДОЧИТЬ ПО Цена УБЫВ, Наименование";
	ИначеЕсли Сортировка = "По производителю" Тогда
		Запрос.Текст = Запрос.Текст + "УПОРЯДОЧИТЬ ПО Производитель, Наименование";
	Иначе
		Запрос.Текст = Запрос.Текст + "УПОРЯДОЧИТЬ ПО Наименование";
	КонецЕсли;

	Товары.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Выборка);
		Данные = Выборка.Товар.Картинка.Получить();
		Если Данные <> Неопределено Тогда
			Стр.Фото = Новый Картинка(Данные);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	ОбновитьТовары();
КонецПроцедуры

&НаКлиенте
Процедура Подробнее(Команда)
	ТД = Элементы.Товары.ТекущиеДанные;
	Если ТД = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите товар в списке");
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ПолучитьОписаниеТовара(ТД.Товар));
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОписаниеТовара(Товар)
	Результат = "Состав: " + Товар.Состав + Символы.ПС + Символы.ПС
		+ "Описание: " + Товар.Описание + Символы.ПС + Символы.ПС;
	Размеры = РаботаСТоварами.ДоступныеРазмеры(Товар);
	Если Размеры.Количество() = 0 Тогда
		Возврат Результат + "Нет в наличии";
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого Элемент Из Размеры Цикл
		Части.Добавить(Элемент.Представление);
	КонецЦикла;
	Возврат Результат + "Доступные размеры: " + СтрСоединить(Части, "; ");
КонецФункции

// ===================== ЗАКАЗ ИЗ КАТАЛОГА =====================

&НаКлиенте
Процедура Заказать(Команда)
	ТД = Элементы.Товары.ТекущиеДанные;
	Если ТД = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите товар в списке");
		Возврат;
	КонецЕсли;
	Размеры = РаботаСТоварами.ДоступныеРазмеры(ТД.Товар);
	Если Размеры.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Для этой модели нет доступных размеров");
		Возврат;
	КонецЕсли;
	Доп = Новый Структура("Товар, Наименование, Цена", ТД.Товар, ТД.Наименование, ТД.Цена);
	Размеры.ПоказатьВыборЭлемента(
		Новый ОписаниеОповещения("ПослеВыбораРазмераЗаказа", ЭтотОбъект, Доп), "Выберите размер");
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораРазмераЗаказа(Элемент, Доп) Экспорт
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Доп.Вставить("Размер", Элемент.Значение);
	Представление = Элемент.Представление;
	ПозицияСкобки = Найти(Представление, " (");
	Если ПозицияСкобки > 0 Тогда
		Представление = Лев(Представление, ПозицияСкобки - 1);
	КонецЕсли;
	Доп.Вставить("РазмерТекст", Представление);
	ПоказатьВводЧисла(Новый ОписаниеОповещения("ПослеВводаКоличестваЗаказа", ЭтотОбъект, Доп),
		1, "Сколько пар заказать?", 3, 0);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаКоличестваЗаказа(Количество, Доп) Экспорт
	Если Количество = Неопределено Или Количество <= 0 Тогда
		Возврат;
	КонецЕсли;
	Доп.Вставить("Количество", Количество);
	Итог = Количество * Доп.Цена;
	Текст = Доп.Наименование + Символы.ПС
		+ "Размер: " + Доп.РазмерТекст + Символы.ПС
		+ Количество + " пар × " + Формат(Доп.Цена, "ЧДЦ=2; ЧГ=3,0") + " руб. = "
		+ Формат(Итог, "ЧДЦ=2; ЧГ=3,0") + " руб." + Символы.ПС + Символы.ПС
		+ "Оформить заказ?";
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтвержденияЗаказа", ЭтотОбъект, Доп),
		Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Подтверждение заказа");
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияЗаказа(Ответ, Доп) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Результат = ОформитьЗаказНаСервере(Доп.Товар, Доп.Размер, Доп.Количество);
	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Текст);
		Возврат;
	КонецЕсли;
		Оповестить("ИзмененыОстатки");;

	ПутьВыписки = СохранитьВыписку(Результат.Выписка, Результат.Номер);
	Если ПутьВыписки = "" Тогда
		ПоказатьПредупреждение(, Результат.Текст + Символы.ПС + Символы.ПС
			+ "Выписку сохранить на компьютер не удалось.");
	Иначе
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОткрытьВыписку", ЭтотОбъект, ПутьВыписки),
			Результат.Текст + Символы.ПС + Символы.ПС + "Выписка сохранена:" + Символы.ПС + ПутьВыписки
			+ Символы.ПС + Символы.ПС + "Открыть файл?",
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Заказ оформлен");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОткрытьВыписку(Ответ, ПутьВыписки) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗапуститьПриложение("notepad.exe """ + ПутьВыписки + """");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция СохранитьВыписку(ТекстВыписки, НомерЗаказа)
	Каталог = КаталогДокументов();
	Если Прав(Каталог, 1) <> "\" Тогда
		Каталог = Каталог + "\";
	КонецЕсли;
	Каталог = Каталог + "Мир обуви - заказы\";
	Попытка
		СоздатьКаталог(Каталог);
		ИмяФайла = Каталог + "Заказ_" + НомерЗаказа + "_"
			+ Формат(ТекущаяДата(), "ДФ=dd-MM-yyyy_HH-mm") + ".txt";
		ТекстовыйФайл = Новый ТекстовыйДокумент;
		ТекстовыйФайл.УстановитьТекст(ТекстВыписки);
		ТекстовыйФайл.Записать(ИмяФайла, КодировкаТекста.UTF8);
		Возврат ИмяФайла;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ОформитьЗаказНаСервере(Товар, Размер, Количество)
	Результат = Новый Структура("Успех, Текст, Выписка, Номер", Ложь, "", "", "");

	Если РаботаСПользователем.ТекущаяРоль() = "Гость" Или ПараметрыСеанса.ТекущийПользователь.Пустая() Тогда
		Результат.Текст = "Оформить заказ может только авторизованный пользователь";
		Возврат Результат;
	КонецЕсли;

	Док = Документы.Заказ.СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();
	Док.Клиент = ПараметрыСеанса.ТекущийПользователь;
	НоваяСтрока = Док.Товары.Добавить();
	НоваяСтрока.Товар = Товар;
	НоваяСтрока.Размер = Размер;
	НоваяСтрока.Количество = Количество;
	НоваяСтрока.Цена = Товар.Цена;
	НоваяСтрока.Сумма = Количество * Товар.Цена;
	Док.ИтоговаяСумма = НоваяСтрока.Сумма;

	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Результат.Текст = "Заказ не оформлен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = Истина;
	Результат.Номер = Док.Номер;
	Результат.Выписка = ВыпискаЗаказа(Док);
	Результат.Текст = "Заказ № " + Док.Номер + " оформлен: " + Количество + " пар на сумму "
		+ ДеньгиТекст(Док.ИтоговаяСумма) + " руб.";
	Возврат Результат;
КонецФункции

// ===================== ОФОРМЛЕНИЕ ВЫПИСКИ =====================

&НаСервереБезКонтекста
Функция ДеньгиТекст(Число)
	Возврат СтрЗаменить(Формат(Число, "ЧДЦ=2; ЧГ=3,0"), Символы.НПП, " ");
КонецФункции

&НаСервереБезКонтекста
Функция Повтор(Символ, Количество)
	Результат = "";
	Для Н = 1 По Количество Цикл
		Результат = Результат + Символ;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция Дополнить(Текст, Длина, ПоПравому = Ложь)
	Пробелы = Повтор(" ", Длина);
	Если ПоПравому Тогда
		Возврат Прав(Пробелы + Текст, Длина);
	КонецЕсли;
	Возврат Лев(Текст + Пробелы, Длина);
КонецФункции

&НаСервереБезКонтекста
Функция ПоЦентру(Текст, Ширина)
	Отступ = Цел((Ширина - СтрДлина(Текст)) / 2);
	Если Отступ < 0 Тогда
		Отступ = 0;
	КонецЕсли;
	Возврат Повтор(" ", Отступ) + Текст;
КонецФункции

&НаСервереБезКонтекста
Функция РазбитьПоШирине(Текст, Ширина)
	Строки = Новый Массив;
	Текущая = "";
	Для Каждого Слово Из СтрРазделить(Текст, " ", Ложь) Цикл
		Остаток = Слово;
		Если СтрДлина(Остаток) > Ширина Тогда
			Если Текущая <> "" Тогда
				Строки.Добавить(Текущая);
				Текущая = "";
			КонецЕсли;
			Пока СтрДлина(Остаток) > Ширина Цикл
				Строки.Добавить(Лев(Остаток, Ширина));
				Остаток = Сред(Остаток, Ширина + 1);
			КонецЦикла;
			Текущая = Остаток;
		ИначеЕсли Текущая = "" Тогда
			Текущая = Остаток;
		ИначеЕсли СтрДлина(Текущая) + 1 + СтрДлина(Остаток) <= Ширина Тогда
			Текущая = Текущая + " " + Остаток;
		Иначе
			Строки.Добавить(Текущая);
			Текущая = Остаток;
		КонецЕсли;
	КонецЦикла;
	Если Текущая <> "" Тогда
		Строки.Добавить(Текущая);
	КонецЕсли;
	Если Строки.Количество() = 0 Тогда
		Строки.Добавить("");
	КонецЕсли;
	Возврат Строки;
КонецФункции

&НаСервереБезКонтекста
Функция ВыпискаЗаказа(Док)
	Ширина = 80;
	Двойная = Повтор("=", Ширина);
	Одинарная = Повтор("-", Ширина);
	Т = Новый Массив;

	Т.Добавить(Двойная);
	Т.Добавить(ПоЦентру("М И Р   О Б У В И", Ширина));
	Т.Добавить(ПоЦентру("Выписка по заказу № " + Док.Номер, Ширина));
	Т.Добавить(Двойная);
	Т.Добавить("");
	Т.Добавить("Дата заказа : " + Формат(Док.Дата, "ДФ='dd.MM.yyyy HH:mm'"));
	Т.Добавить("Клиент      : " + Док.Клиент.Наименование);
	Т.Добавить("");
	Т.Добавить(Одинарная);
	Т.Добавить(Дополнить("№", 3, Истина) + "  " + Дополнить("Наименование", 30) + "  "
		+ Дополнить("Размер", 6) + "  " + Дополнить("Кол.", 4, Истина) + "  "
		+ Дополнить("Цена за 1 пару", 14, Истина) + "  " + Дополнить("Сумма", 13, Истина));
	Т.Добавить(Одинарная);

	ВсегоПар = 0;
	НомерПозиции = 0;
	Для Каждого Стр Из Док.Товары Цикл
		НомерПозиции = НомерПозиции + 1;
		ВсегоПар = ВсегоПар + Стр.Количество;
		ЧастиНазвания = РазбитьПоШирине(Стр.Товар.Наименование, 30);
		Т.Добавить(Дополнить(Строка(НомерПозиции), 3, Истина) + "  " + Дополнить(ЧастиНазвания[0], 30) + "  "
			+ Дополнить(Стр.Размер.Наименование, 6) + "  "
			+ Дополнить(Формат(Стр.Количество, "ЧГ=0"), 4, Истина) + "  "
			+ Дополнить(ДеньгиТекст(Стр.Цена), 14, Истина) + "  "
			+ Дополнить(ДеньгиТекст(Стр.Сумма), 13, Истина));
		Для Н = 1 По ЧастиНазвания.Количество() - 1 Цикл
			Т.Добавить(Повтор(" ", 5) + ЧастиНазвания[Н]);
		КонецЦикла;
	КонецЦикла;

	Т.Добавить(Одинарная);
	Т.Добавить("Позиций: " + НомерПозиции + "      Всего пар: " + Формат(ВсегоПар, "ЧГ=0"));
	Т.Добавить("");
	Т.Добавить(Дополнить("ИТОГО К ОПЛАТЕ:  " + ДеньгиТекст(Док.ИтоговаяСумма) + " руб.", Ширина, Истина));
	Т.Добавить(Двойная);
	Т.Добавить(ПоЦентру("Валюта расчётов: рубли (RUB)", Ширина));
	Т.Добавить(ПоЦентру("Спасибо за покупку! Ждём вас снова в «Мир обуви»", Ширина));
	Т.Добавить(Двойная);

	Возврат СтрСоединить(Т, Символы.ПС);
КонецФункции