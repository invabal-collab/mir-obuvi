Процедура ПередЗаписью(Отказ)
	Наименование = СокрЛП(Фамилия + " " + Имя + " " + Отчество);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Пользователи
	|ГДЕ Логин = &Логин И Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Логин", Логин);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Не Запрос.Выполнить().Пустой() Тогда
		Сообщить("Пользователь с таким логином уже существует");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры