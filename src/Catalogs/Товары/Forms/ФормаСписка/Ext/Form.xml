				<QueryText>ВЫБРАТЬ
	Т.Ссылка КАК Ссылка,
	Т.Код КАК Код,
	Т.Наименование КАК Наименование,
	Т.Категория КАК Категория,
	Т.Подкатегория КАК Подкатегория,
	Т.Производитель КАК Производитель,
	Т.Цена КАК Цена,
	ЕСТЬNULL(Ост.Количество, 0) КАК Количество,
	Т.Цена * ЕСТЬNULL(Ост.Количество, 0) КАК СтоимостьОстатка,
	ЕСТЬNULL(Прод.Количество, 0) КАК Продано,
	ЕСТЬNULL(Прод.Сумма, 0) КАК Выручка,
	ВЫБОР
		КОГДА ЕСТЬNULL(Прод.Количество, 0) &gt; 0
			ТОГДА "Продан"
		ИНАЧЕ "Не продан"
	КОНЕЦ КАК СтатусПродажи
ИЗ
	Справочник.Товары КАК Т
		ЛЕВОЕ СОЕДИНЕНИЕ (
			ВЫБРАТЬ
				О.Товар КАК Товар,
				СУММА(О.КоличествоОстаток) КАК Количество
			ИЗ
				РегистрНакопления.ОстаткиТоваров.Остатки КАК О
			СГРУППИРОВАТЬ ПО
				О.Товар) КАК Ост
		ПО Ост.Товар = Т.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (
			ВЫБРАТЬ
				З.Товар КАК Товар,
				СУММА(З.Количество) КАК Количество,
				СУММА(З.Сумма) КАК Сумма
			ИЗ
				Документ.Заказ.Товары КАК З
			ГДЕ
				НЕ З.Ссылка.ПометкаУдаления
			СГРУППИРОВАТЬ ПО
				З.Товар) КАК Прод
		ПО Прод.Товар = Т.Ссылка</QueryText>
