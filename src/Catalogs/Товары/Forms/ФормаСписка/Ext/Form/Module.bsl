// ===================== ИТОГИ, ФИЛЬТР И ОТЧЁТ =====================

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(СтатусПоказа) Тогда
		СтатусПоказа = "Все";
	КонецЕсли;
	ОбновитьИтогиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ИзмененыОстатки" Тогда
		Элементы.Список.Обновить();
		ОбновитьИтогиНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтатусПоказаПриИзменении(Элемент)
	ОбновитьИтогиНаСервере();
	Элементы.Список.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОтчет(Команда)
	ТекстОтчета = СформироватьОтчетНаСервере();
	Путь = СохранитьОтчет(ТекстОтчета);
	Если Путь = "" Тогда
		ПоказатьПредупреждение(, "Отчёт сформирован, но сохранить файл не удалось."
			+ Символы.ПС + "Проверьте права записи в папку «Документы».");
	Иначе
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОткрытьОтчет", ЭтотОбъект, Путь),
			"Отчёт сохранён:" + Символы.ПС + Путь + Символы.ПС + Символы.ПС + "Открыть файл?",
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Выгрузка отчёта");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОткрытьОтчет(Ответ, Путь) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗапуститьПриложение("notepad.exe """ + Путь + """");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция СохранитьОтчет(Текст)
	Каталог = КаталогДокументов();
	Если Прав(Каталог, 1) <> "\" Тогда
		Каталог = Каталог + "\";
	КонецЕсли;
	Каталог = Каталог + "Мир обуви - отчеты\";
	Попытка
		СоздатьКаталог(Каталог);
		ИмяФайла = Каталог + "Отчет_по_складу_" + Формат(ТекущаяДата(), "ДФ=dd-MM-yyyy_HH-mm") + ".txt";
		Док = Новый ТекстовыйДокумент;
		Док.УстановитьТекст(Текст);
		Док.Записать(ИмяФайла, КодировкаТекста.UTF8);
		Возврат ИмяФайла;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// ===================== СЕРВЕРНАЯ ЧАСТЬ =====================

&НаСервере
Процедура ОбновитьИтогиНаСервере()
	Отбор = Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	Отбор.Элементы.Очистить();
	Если СтатусПоказа = "Проданные" Тогда
		ДобавитьОтборСтатус(Отбор, "Продан");
	ИначеЕсли СтатусПоказа = "Не проданные" Тогда
		ДобавитьОтборСтатус(Отбор, "Не продан");
	КонецЕсли;

	Выборка = ПолучитьДанныеПоТоварам().Выбрать();
	ОбщаяСтоимость = 0;
	ВсегоПар = 0;
	Выручка = 0;
	ПроданоМоделей = 0;
	НеПроданоМоделей = 0;
	Пока Выборка.Следующий() Цикл
		ВсегоПар = ВсегоПар + Выборка.Количество;
		ОбщаяСтоимость = ОбщаяСтоимость + Выборка.Цена * Выборка.Количество;
		Выручка = Выручка + Выборка.Выручка;
		Если Выборка.Продано > 0 Тогда
			ПроданоМоделей = ПроданоМоделей + 1;
		Иначе
			НеПроданоМоделей = НеПроданоМоделей + 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ДобавитьОтборСтатус(Отбор, ЗначениеСтатуса)
	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СтатусПродажи");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ЗначениеСтатуса;
	ЭлементОтбора.Использование = Истина;
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеПоТоварам(Условие = "")
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Наименование КАК Наименование,
	|	Т.Цена КАК Цена,
	|	ЕСТЬNULL(Ост.Количество, 0) КАК Количество,
	|	ЕСТЬNULL(Прод.Количество, 0) КАК Продано,
	|	ЕСТЬNULL(Прод.Сумма, 0) КАК Выручка
	|ИЗ
	|	Справочник.Товары КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				О.Товар КАК Товар,
	|				СУММА(О.КоличествоОстаток) КАК Количество
	|			ИЗ
	|				РегистрНакопления.ОстаткиТоваров.Остатки КАК О
	|			СГРУППИРОВАТЬ ПО
	|				О.Товар) КАК Ост
	|		ПО Ост.Товар = Т.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				З.Товар КАК Товар,
	|				СУММА(З.Количество) КАК Количество,
	|				СУММА(З.Сумма) КАК Сумма
	|			ИЗ
	|				Документ.Заказ.Товары КАК З
	|			ГДЕ
	|				НЕ З.Ссылка.ПометкаУдаления
	|			СГРУППИРОВАТЬ ПО
	|				З.Товар) КАК Прод
	|		ПО Прод.Товар = Т.Ссылка
	|" + Условие + "
	|УПОРЯДОЧИТЬ ПО
	|	Т.Наименование");
	Возврат Запрос.Выполнить();
КонецФункции

&НаСервере
Функция СформироватьОтчетНаСервере()
	Ширина = 110;
	Двойная = Повтор("=", Ширина);
	Одинарная = Повтор("-", Ширина);
	Т = Новый Массив;

	ЗаголовокНабора = СтатусПоказа;
	Если Не ЗначениеЗаполнено(ЗаголовокНабора) Тогда
		ЗаголовокНабора = "Все";
	КонецЕсли;

	Условие = "";
	Если СтатусПоказа = "Проданные" Тогда
		Условие = "ГДЕ
		|	ЕСТЬNULL(Прод.Количество, 0) > 0";
	ИначеЕсли СтатусПоказа = "Не проданные" Тогда
		Условие = "ГДЕ
		|	ЕСТЬNULL(Прод.Количество, 0) = 0";
	КонецЕсли;

	Выборка = ПолучитьДанныеПоТоварам(Условие).Выбрать();

	Т.Добавить(Двойная);
	Т.Добавить(ПоЦентру("М И Р   О Б У В И", Ширина));
	Т.Добавить(ПоЦентру("Сводный отчёт по складу — " + ЗаголовокНабора, Ширина));
	Т.Добавить(Двойная);
	Т.Добавить("");
	Т.Добавить("Сформировано: " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'"));
	Т.Добавить("");

	Т.Добавить(Одинарная);
	Т.Добавить(Дополнить("№", 3, Истина) + "  " + Дополнить("Наименование", 28) + "  "
		+ Дополнить("Цена, руб.", 12, Истина) + "  " + Дополнить("Наличие", 7, Истина) + "  "
		+ Дополнить("Стоим., руб.", 14, Истина) + "  " + Дополнить("Продано, пар", 13, Истина) + "  "
		+ Дополнить("Выручка, руб.", 14, Истина) + "  " + Дополнить("Статус", 10));
	Т.Добавить(Одинарная);

	Номер = 0;
	ИтогоСтоимость = 0;
	ИтогоПар = 0;
	ИтогоПродано = 0;
	ИтогоВыручка = 0;
	Пока Выборка.Следующий() Цикл
		Номер = Номер + 1;
		Стоимость = Выборка.Цена * Выборка.Количество;
		ИтогоСтоимость = ИтогоСтоимость + Стоимость;
		ИтогоПар = ИтогоПар + Выборка.Количество;
		ИтогоПродано = ИтогоПродано + Выборка.Продано;
		ИтогоВыручка = ИтогоВыручка + Выборка.Выручка;
		Статус = ?(Выборка.Продано > 0, "Продан", "Не продан");
		Части = РазбитьПоШирине(Выборка.Наименование, 28);
		Т.Добавить(Дополнить(Строка(Номер), 3, Истина) + "  " + Дополнить(Части[0], 28) + "  "
			+ Дополнить(ДеньгиТекст(Выборка.Цена), 12, Истина) + "  "
			+ Дополнить(Формат(Выборка.Количество, "ЧГ=0"), 7, Истина) + "  "
			+ Дополнить(ДеньгиТекст(Стоимость), 14, Истина) + "  "
			+ Дополнить(Формат(Выборка.Продано, "ЧГ=0"), 13, Истина) + "  "
			+ Дополнить(ДеньгиТекст(Выборка.Выручка), 14, Истина) + "  "
			+ Дополнить(Статус, 10));
		Для Н = 1 По Части.Количество() - 1 Цикл
			Т.Добавить(Повтор(" ", 5) + Части[Н]);
		КонецЦикла;
	КонецЦикла;

	Т.Добавить(Одинарная);
	Т.Добавить(Дополнить("ИТОГО:", 33) + Дополнить(ДеньгиТекст(ИтогоСтоимость), 12, Истина) + "  "
		+ Дополнить(Формат(ИтогоПар, "ЧГ=0"), 7, Истина) + "  " + Дополнить("", 14) + "  "
		+ Дополнить(Формат(ИтогоПродано, "ЧГ=0"), 13, Истина) + "  "
		+ Дополнить(ДеньгиТекст(ИтогоВыручка), 14, Истина));
	Т.Добавить(Одинарная);
	Т.Добавить("");
	Т.Добавить("Всего наименований в отчёте: " + Номер);
	Т.Добавить(Двойная);
	Т.Добавить(ПоЦентру("Мир обуви — внутренний отчёт", Ширина));
	Т.Добавить(Двойная);

	Возврат СтрСоединить(Т, Символы.ПС);
КонецФункции

// ===================== СЕРВИСНЫЕ ФУНКЦИИ ОФОРМЛЕНИЯ =====================
// (их копия есть в модуле обработки «Каталог» — здесь нужны свои, у форм разные модули)

&НаСервереБезКонтекста
Функция ДеньгиТекст(Число)
	Возврат СтрЗаменить(Формат(Число, "ЧДЦ=2; ЧГ=3,0"), Символы.НПП, " ");
КонецФункции

&НаСервереБезКонтекста
Функция Повтор(Символ, Количество)
	Результат = "";
	Для Н = 1 По Количество Цикл
		Результат = Результат + Символ;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция Дополнить(Текст, Длина, ПоПравому = Ложь)
	Пробелы = Повтор(" ", Длина);
	Если ПоПравому Тогда
		Возврат Прав(Пробелы + Текст, Длина);
	КонецЕсли;
	Возврат Лев(Текст + Пробелы, Длина);
КонецФункции

&НаСервереБезКонтекста
Функция ПоЦентру(Текст, Ширина)
	Отступ = Цел((Ширина - СтрДлина(Текст)) / 2);
	Если Отступ < 0 Тогда
		Отступ = 0;
	КонецЕсли;
	Возврат Повтор(" ", Отступ) + Текст;
КонецФункции

&НаСервереБезКонтекста
Функция РазбитьПоШирине(Текст, Ширина)
	Строки = Новый Массив;
	Текущая = "";
	Для Каждого Слово Из СтрРазделить(Текст, " ", Ложь) Цикл
		Если Текущая = "" Тогда
			Текущая = Слово;
		ИначеЕсли СтрДлина(Текущая) + 1 + СтрДлина(Слово) <= Ширина Тогда
			Текущая = Текущая + " " + Слово;
		Иначе
			Строки.Добавить(Текущая);
			Текущая = Слово;
		КонецЕсли;
	КонецЦикла;
	Если Текущая <> "" Тогда
		Строки.Добавить(Текущая);
	КонецЕсли;
	Если Строки.Количество() = 0 Тогда
		Строки.Добавить("");
	КонецЕсли;
	Возврат Строки;
КонецФункции