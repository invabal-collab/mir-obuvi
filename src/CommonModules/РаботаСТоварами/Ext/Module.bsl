                Функция ДоступныеРазмеры(Товар) Экспорт
	Список = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	О.Размер КАК Размер,
	|	О.Размер.Наименование КАК РазмерИмя,
	|	О.Размер.Значение КАК Знач,
	|	О.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(, Товар = &Товар) КАК О
	|ГДЕ
	|	О.КоличествоОстаток > 0
	|УПОРЯДОЧИТЬ ПО
	|	Знач";
	Запрос.УстановитьПараметр("Товар", Товар);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.Размер,
			Выборка.РазмерИмя + " (в наличии: " + Формат(Выборка.Количество, "ЧГ=0") + ")");
	КонецЦикла;
	Возврат Список;
КонецФункции

Функция ЦенаТовара(Товар) Экспорт
	Возврат Товар.Цена;
КонецФункции