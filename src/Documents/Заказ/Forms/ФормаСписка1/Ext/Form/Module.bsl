&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Роль = РаботаСПользователем.ТекущаяРоль();
	Если Роль = "Гость" Тогда
		Сообщить("Войдите в систему, чтобы оформить заказ");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Управляющий = (Роль = "Менеджер" Или Роль = "Администратор");

	// Если мы пришли из каталога с выбранным товаром
	Если Параметры.Свойство("НачальныйТовар") Тогда
		НовыйЗаказ = Документы.Заказ.СоздатьДокумент();
		
		// Обычный пользователь заказывает только для себя
		Если Не Управляющий Тогда
			НовыйЗаказ.Клиент = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
		
		// Добавляем товар
		Стр = НовыйЗаказ.Товары.Добавить();
		Стр.Товар = Параметры.НачальныйТовар;
		Стр.Цена = Стр.Товар.Цена;
		Стр.Количество = 1;
		Стр.Сумма = Стр.Цена;
		НовыйЗаказ.ИтоговаяСумма = Стр.Сумма;
		
		// Запоминаем ссылку на новый заказ в параметрах формы, 
		// чтобы открыть его позже на клиенте
		ПараметрыФормы = Новый Структура("Ключ", НовыйЗаказ);
		Параметры.Вставить("ЗаказДляОткрытия", ПараметрыФормы);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Открываем созданный заказ на клиенте (только если он был создан на сервере)
	Если Параметры.Свойство("ЗаказДляОткрытия") Тогда
		ОткрытьФорму("Документ.Заказ.ФормаДокумента", Параметры.ЗаказДляОткрытия, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("ИзмененыОстатки");
КонецПроцедуры
