Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	ИтоговаяСумма = 0;
	Для Каждого Стр Из Товары Цикл
		Если Стр.Количество <= 0 Тогда
			Сообщить("Количество в строке " + Стр.НомерСтроки + " должно быть больше нуля");
			Отказ = Истина;
		КонецЕсли;
		Стр.Сумма = Стр.Количество * Стр.Цена;
		ИтоговаяСумма = ИтоговаяСумма + Стр.Сумма;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения) 
	УстановитьПривилегированныйРежим(Истина);
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.БлокироватьДляИзменения = Истина;
	Для Каждого Стр Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = Стр.Товар;
		Движение.Размер = Стр.Размер;
		Движение.Количество = Стр.Количество;
	КонецЦикла;
	Движения.Записать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	О.Товар.Наименование КАК Товар,
	|	О.Размер.Наименование КАК Размер
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(, Товар В (&Товары)) КАК О
	|ГДЕ
	|	О.КоличествоОстаток < 0";
	Запрос.УстановитьПараметр("Товары", Товары.ВыгрузитьКолонку("Товар"));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВызватьИсключение "Недостаточно товара: " + Выборка.Товар + ", размер " + Выборка.Размер;
	КонецЕсли;
КонецПроцедуры